#!/bin/sh
# Pre-push hook - Fast validation before push
# Full validation happens in CI (builds, tests, e2e)

set -e

echo ""
echo "========================================"
echo "Pre-push Hook - Fast Validation"
echo "========================================"
echo ""

FAILED=0

run_check() {
    local cmd="$1"
    local name="$2"
    local timeout_sec="${3:-120}"
    
    echo "Running: $name (timeout: ${timeout_sec}s)"
    
    if timeout "$timeout_sec" sh -c "$cmd"; then
        echo "   [PASS] $name"
    else
        local exit_code=$?
        if [ $exit_code -eq 124 ]; then
            echo "   [TIMEOUT] $name - timed out"
        else
            echo "   [FAIL] $name"
        fi
        FAILED=1
    fi
}

# 1. TypeScript type check (fast ~30s)
echo ""
echo "[1/4] TypeScript Type Check"
run_check "pnpm run typecheck" "TypeScript Type Check" 120

# 2. ESLint on src files and tests with cache (fast ~30s)
echo ""
echo "[2/4] ESLint (src files and tests)"
run_check "./node_modules/.bin/eslint app/main/src app/renderer/src packages/contracts/src tests --max-warnings=0 --cache" "ESLint" 180

# 3. Quick git status check
echo ""
echo "[3/4] Git Status Check"
run_check "git status --short | head -20" "Git Status" 10

# 4. Build contracts to verify project structure
echo ""
echo "[4/4] Build Contracts"
run_check "pnpm run build:contracts" "Build Contracts" 60

echo ""
echo "========================================"
echo "Fast Validation Complete"
echo "========================================"

if [ $FAILED -eq 0 ]; then
    echo ""
    echo "Fast checks PASSED!"
    echo ""
    echo "Full validation running on CI:"
    echo "  - Build Main (3-4 min)"
    echo "  - Build Renderer (4-5 min)"
    echo "  - All tests (2-3 min)"
    echo "  - Security audit"
    echo "  - E2E tests"
    echo ""
    echo "Pushing code..."
    exit 0
else
    echo ""
    echo "Fast checks FAILED!"
    echo ""
    echo "Fix issues above before pushing."
    echo "Full CI will catch any remaining issues."
    exit 1
fi
