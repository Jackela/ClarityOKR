{
  "name": "@clarityokr/main",
  "version": "0.3.0",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/bootstrap/preload.ts --bundle --platform=browser --format=cjs --external:electron --outfile=dist/bootstrap/preload.cjs",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "dev": "electron --inspect=5858 .",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@clarityokr/contracts": "workspace:^",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.4.5",
    "electron": "44.9.3",
    "lru-cache": "^11.2.7",
    "opossum": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/opossum": "^8.1.8",
    "typescript": "~5.9.3",
    "esbuild": "0.28.1"
  }
}
