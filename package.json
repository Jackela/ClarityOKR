{
  "name": "clarityokr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClarityOKR desktop assistant workspace",
  "license": "MIT",
  "author": "Jackela",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jackela/ClarityOKR.git"
  },
  "bugs": {
    "url": "https://github.com/Jackela/ClarityOKR/issues"
  },
  "homepage": "https://github.com/Jackela/ClarityOKR#readme",
  "keywords": [
    "electron",
    "angular",
    "typescript",
    "okr",
    "ai-assistant",
    "desktop-app",
    "productivity",
    "llm",
    "sqlite"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "setup-hooks": "./scripts/setup-hooks.sh",
    "test:integration": "pnpm --filter @clarityokr/tests-integration run test",
    "lint": "pnpm exec eslint . --cache --cache-location .eslintcache",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.typecheck.json",
    "build": "pnpm run build:contracts && pnpm run build:main && pnpm run build:renderer",
    "build:parallel": "pnpm run build:contracts & pnpm run build:main & wait && pnpm run build:renderer",
    "build:ci": "pnpm run build:contracts && pnpm run build:main && pnpm run build:renderer:ci",
    "build:contracts": "pnpm --filter @clarityokr/contracts run build",
    "build:renderer": "pnpm --filter @clarityokr/renderer run build",
    "build:renderer:ci": "cd app/renderer && pnpm exec ng build --watch=false --progress=false",
    "build:electron": "echo 'No electron builder configured'",
    "build:main": "pnpm --filter @clarityokr/main run build",
    "clean": "pnpm --filter @clarityokr/contracts run clean 2>/dev/null || true && pnpm --filter @clarityokr/main run clean 2>/dev/null || true && rimraf app/renderer/dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "dev": "pnpm --filter @clarityokr/desktop run dev",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:component && pnpm run test:e2e",
    "test:unit": "pnpm --filter @clarityokr/tests-unit run test",
    "test:component": "pnpm --filter @clarityokr/renderer run test",
    "test:e2e": "pnpm --filter @clarityokr/tests-e2e run test",
    "test:e2e:ci": "pnpm --filter @clarityokr/tests-e2e run test:ci",
    "test:e2e:prepush": "pnpm --filter @clarityokr/tests-e2e run test:prepush",
    "test:performance": "pnpm --filter @clarityokr/tests-performance run test",
    "lint:fix": "pnpm exec eslint . --fix --cache --cache-location .eslintcache",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@angular-devkit/build-angular": "17.3.12",
    "@playwright/test": "^1.44.0",
    "@types/node": "~20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "get-port": "^7.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.0",
    "typescript": "~5.4.5"
  },
  "pnpm": {
    "overrides": {
      "node-forge": ">=1.3.2"
    }
  },
  "main": "app/main/dist/main.js"
}
