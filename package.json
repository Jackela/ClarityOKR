{
  "name": "clarityokr",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "ClarityOKR desktop assistant workspace",
  "license": "MIT",
  "author": "Jackela",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jackela/ClarityOKR.git"
  },
  "bugs": {
    "url": "https://github.com/Jackela/ClarityOKR/issues"
  },
  "homepage": "https://github.com/Jackela/ClarityOKR#readme",
  "keywords": [
    "electron",
    "angular",
    "typescript",
    "okr",
    "ai-assistant",
    "desktop-app",
    "productivity",
    "llm",
    "sqlite"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "setup-hooks": "./scripts/setup-hooks.sh",
    "test:integration": "pnpm run native:node && pnpm --filter @clarityokr/tests-integration run test",
    "lint": "pnpm exec eslint . --cache --cache-location .eslintcache",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.typecheck.json",
    "build": "pnpm run build:contracts && pnpm run build:main && pnpm run build:renderer",
    "build:parallel": "pnpm run build:contracts & pnpm run build:main & wait && pnpm run build:renderer",
    "build:ci": "pnpm run build:contracts && pnpm run build:main && pnpm run build:renderer:ci",
    "build:contracts": "pnpm --filter @clarityokr/contracts run build",
    "build:renderer": "pnpm --filter @clarityokr/renderer run build",
    "build:renderer:ci": "cd app/renderer && pnpm exec ng build --watch=false --progress=false",
    "build:electron": "node scripts/stage-app.mjs && electron-builder --config electron-builder.config.cjs",
    "build:main": "pnpm --filter @clarityokr/main run build",
    "clean": "pnpm --filter @clarityokr/contracts run clean 2>/dev/null || true && pnpm --filter @clarityokr/main run clean 2>/dev/null || true && rimraf app/renderer/dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "dev": "pnpm --filter @clarityokr/desktop run dev",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:component && pnpm run test:e2e",
    "native:node": "node scripts/ensure-native.mjs node",
    "native:electron": "node scripts/ensure-native.mjs electron",
    "test:unit": "pnpm run native:node && pnpm --filter @clarityokr/tests-unit run test",
    "test:component": "pnpm --filter @clarityokr/renderer run test",
    "test:e2e": "pnpm run build && pnpm run native:electron && pnpm --filter @clarityokr/tests-e2e run test:ci",
    "test:e2e:ci": "pnpm --filter @clarityokr/tests-e2e run test:ci",
    "test:e2e:prepush": "pnpm --filter @clarityokr/tests-e2e run test:prepush",
    "test:performance": "pnpm --filter @clarityokr/tests-performance run test",
    "lint:fix": "pnpm exec eslint . --fix --cache --cache-location .eslintcache",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "audit:security": "node scripts/security-audit.mjs",
    "test:audit": "node --test scripts/security-audit.test.mjs",
    "test:release-config": "node --test scripts/release-config.test.mjs",
    "rebuild:electron": "electron-rebuild --force --module-dir app/main --which-module better-sqlite3",
    "coverage:check": "node scripts/check-coverage.mjs",
    "test:coverage": "node scripts/run-coverage.mjs",
    "rebuild:node": "pnpm --filter @clarityokr/main rebuild better-sqlite3",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs",
    "build:coverage": "node scripts/build-source-coverage.mjs",
    "coverage:remap:e2e": "node scripts/remap-source-coverage.mjs",
    "coverage:collect": "node scripts/run-coverage.mjs --collect-only",
    "test:coverage-integrity": "node --test scripts/coverage-integrity.test.mjs scripts/original-source-instrument.test.mjs scripts/coverage-gate.test.mjs"
  },
  "devDependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@angular/build": "22.3.0",
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "17.0.3",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  },
  "main": "app/main/dist/main.js"
}
