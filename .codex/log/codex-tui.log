ma.parse({ sessionId, promptId, optionId });\n    bridge.send(IPC_CHANNELS.CLARIFICATION_RESPOND, payload);\n\n    return of(void 0);\n  }\n\n  markReady(ready: boolean): void {\n    this.store.markReady(ready);\n  }\n\n  private registerPromptListener(): void {\n    const bridge = this.bridge;\n    if (!bridge || this.isListenerRegistered) {\n      return;\n    }\n\n    bridge.on(IPC_CHANNELS.CLARIFICATION_PROMPT, (_event, payload) => {\n      this.zone.run(() => {\n        try {\n          const { prompt } = clarificationPromptResponseSchema.parse(payload);\n          this.store.setPrompt(prompt);\n        } catch (error) {\n          const message = error instanceof Error ? error.message : String(error);\n          this.store.setValidationError(message);\n        }\n      });\n    });\n\n    this.isListenerRegistered = true;\n  }\n\n  private ensureBridge(): ClarifyOkrApi {\n    if (!this.bridge) {\n      throw new Error('ClarifyOKR bridge is unavailable.');\n    }\n\n    return this.bridge;\n  }\n}\nEOF"]}
