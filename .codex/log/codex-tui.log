icationOptionSelectionSchema.parse({ sessionId, promptId, optionId });\n    this.bridge.send(IPC_CHANNELS.CLARIFICATION_RESPOND, payload);\n\n    return of(void 0);\n  }\n\n  markReady(ready: boolean): void {\n    this.store.markReady(ready);\n  }\n\n  private registerPromptListener(): void {\n    if (!this.bridge || this.isListenerRegistered) {\n      return;\n    }\n\n    this.bridge.on(IPC_CHANNELS.CLARIFICATION_PROMPT, (_event, payload) => {\n      this.zone.run(() => {\n        try {\n          const { prompt } = clarificationPromptResponseSchema.parse(payload);\n          this.store.setPrompt(prompt);\n        } catch (error) {\n          this.store.setValidationError(error instanceof Error ? error.message : String(error));\n        }\n      });\n    });\n\n    this.isListenerRegistered = true;\n  }\n}\nEOF"]}
