 async function readJson<T>(file: string): Promise<T | null> {
   try {
     const raw = await fs.readFile(file, 'utf-8');
+    if (!raw.trim()) {
+      return null;
+    }
     return JSON.parse(raw) as T;
   } catch (error) {
     if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
       return null;
     }
+
+    if (error instanceof SyntaxError) {
+      return null;
+    }
 
     throw error;
   }
 }
